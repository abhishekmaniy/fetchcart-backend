{
  "name": "nodeserver",
  "version": "1.0.0",
  "description": "FetchCart AI Product Search Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker:search": "tsx watch src/workers/product-search.worker.ts",
    "dev:worker:compare": "tsx watch src/workers/compare.worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker:search": "node dist/workers/product-search.worker.js",
    "start:worker:compare": "node dist/workers/compare.worker.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "keywords": [
    "nodejs",
    "express",
    "bullmq",
    "websocket",
    "langchain",
    "redis",
    "product-search",
    "product-compare"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.46",
    "@langchain/google-genai": "^2.1.30",
    "@neondatabase/serverless": "^1.0.1",
    "@tavily/core": "^0.7.3",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.8",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.6",
    "resend": "^6.12.4",
    "uuid": "^11.1.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
